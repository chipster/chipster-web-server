{
  "name": "type-service",
  "type": "module",
  "description": "Chipster type-service",
  "scripts": {
    "start": "NODE_ENV=production node lib/type-service.js",
    "build": "npx tsc",
    "compile": "npm run build ; npm run start",
    "dev": "./node_modules/nodemon/bin/nodemon.js -e ts  --exec \"npm run compile\"",
    "test": "rm -rf lib-test && npx tsc -p tsconfig.test.json && node --test \"lib-test/**/*.spec.js\"",
    "test:auto": "./node_modules/nodemon/bin/nodemon.js -e ts --exec \"npm test\"",
    "prettier": "npx prettier --check \"src/**/*.ts\" \"*.{mjs,json}\"",
    "prettier-write": "npx prettier --write \"src/**/*.ts\" \"*.{mjs,json}\"",
    "lint": "npx eslint src/ eslint.config.mjs",
    "lint-fix": "npx eslint --fix src/ eslint.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chipster/chipster-web-server.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/chipster/chipster-web-server#readme",
  "dependencies": {
    "chipster-js-common": "^1.5.0",
    "chipster-nodejs-core": "^0.9.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lodash-es": "^4.17.21",
    "rxjs": "^7.8.1",
    "winston": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.1.10",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.12.0",
    "nodemon": "^3.0.3",
    "prettier": "^3.9.8",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0"
  }
}
