{
  "include": ["src/**/*"],
  // tests are built separately by tsconfig.test.json, so that the deployed
  // lib/ folder contains production code only
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "es2020",
    // keep generated files in separate folder
    "outDir": "./lib"
  }
}
